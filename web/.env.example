# Copy to .env.local and fill with your project values.
# Build can use Supabase placeholders if you only need `npm run build`.

# --- Supabase (required for auth + data) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role: server-only (webhook updates profiles/listings). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional absolute app URL for Stripe redirects (defaults to request Host)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (billing / bumps) — use Test mode keys while developing ---
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Price IDs from Stripe Dashboard → Products (see README)
STRIPE_PRICE_HOMEOWNER=price_homeowner_monthly
STRIPE_PRICE_CONTRACTOR=price_contractor_monthly
STRIPE_PRICE_BUMP=price_bump_one_time
